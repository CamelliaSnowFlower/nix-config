      "id": "166a98a7-1115-4d1e-9910-0c7ff8b3a9c8",
      "name": "List products",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [
        240,
        0
      ],
      "executeOnce": true
    },
    {
      "parameters": {
        "jsCode": "return [{ json: JSON.parse($input.first().json.stdout) }];"
      },
      "id": "1157ca76-695b-415b-a378-06e29608e936",
      "name": "Parse products",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        0
      ]
    },
    {
      "parameters": {
        "resume": "form",
        "formTitle": "Choose a product",
        "formDescription": "=Existing products: {{ $('Parse products').first().json.prefixes.join(', ') }}\\n\\nType one of those three-letter codes into Product to add to an existing product, or leave Product blank and fill in New product letters below to start a brand-new one.",
        "formFields": {
          "values": [
            {
              "fieldLabel": "Product",
              "fieldType": "text",
              "requiredField": false
            },
            {
              "fieldLabel": "New product letters (fill in only if Product above is left blank)",
              "fieldType": "text",
              "requiredField": false
            }
          ]
        },
        "options": {}
      },
      "id": "c7b44ff9-3f58-4342-b559-41be5740a3dc",
      "name": "Choose product",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [
        720,
        0
      ],
      "webhookId": "53e3e3db-008a-4b3b-b8ea-0a982680ba0e"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "110d11b2-9c7b-453e-b3b3-4fbfca8b0176",
              "leftValue": "={{ $json.Product }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "b959b7e0-8463-43ab-8656-46975445ac3b",
      "name": "Is new product?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        960,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const raw = String($json['New product letters (fill in only if Product above is left blank)'] || '').trim().toUpperCase();\nif (!/^[A-Z]{3}$/.test(raw)) {\n  throw new Error('Enter exactly three letters for the new product, e.g. XYZ.');\n}\nconst known = $('Parse products').first().json.prefixes;\nif (known.includes(raw)) {\n  throw new Error(`\"${raw}\" already exists -- leave New product letters blank and type it into Product instead.`);\n}\nreturn [{ json: { prefix: raw, listing: null } }];"
      },
      "id": "27443cd9-4fa5-4fa0-9eb9-ab98d376be4f",
      "name": "Validate new product letters",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1200,
        -160
      ]
    },
    {
      "parameters": {
        "jsCode": "// Re-validate the typed value against the real catalog before it ever\n// reaches a command line -- the same trust-boundary rule sticker-tool\n// itself enforces for every other piece of form/customer input.\nconst raw = String($json.Product || '').trim().toUpperCase();\nconst known = $('Parse products').first().json.prefixes;\nif (!/^[A-Z]{3}$/.test(raw) || !known.includes(raw)) {\n  throw new Error(`\"${raw}\" is not an existing product. Valid codes: ${known.join(', ')}`);\n}\nreturn [{ json: { prefix: raw } }];"
      },
      "id": "f1a2b3c4-5d6e-4f70-8a8b-9c0d1e2f3a5c",
      "name": "Validate chosen prefix",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1200,
        160
      ]
    },
    {
      "parameters": {
        "command": "=sticker-tool list-listings --prefix {{ $json.prefix }}"
      },
      "id": "2f977545-cb2b-4cfd-9357-7c9c752cf0b6",
      "name": "List listings for prefix",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [
        1440,
        160
      ],
      "executeOnce": true
    },
    {
      "parameters": {
        "jsCode": "const prefix = $('Validate chosen prefix').first().json.prefix;\nconst listings = JSON.parse($input.first().json.stdout).listings;\nreturn [{ json: { prefix, listings } }];"
      },
      "id": "e9c1a2b3-4d5e-4f60-8a7b-9c0d1e2f3a4b",
      "name": "Parse listings",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1680,
        160
      ]
    },
    {
      "parameters": {
        "resume": "form",
        "formTitle": "Choose a listing",
        "formDescription": "=Existing listings under {{ $('Parse listings').first().json.prefix }}: {{ $('Parse listings').first().json.listings.map((l) => `${l.sku_root} (${l.variations} variation(s))`).join(', ') || 'none yet' }}\\n\\nType one of those SKUs to add a variation to it, or leave this blank to start the next new listing under this product.",
        "formFields": {
          "values": [
            {
              "fieldLabel": "Existing listing",
              "fieldType": "text",
              "requiredField": false
            }
          ]
        },
        "options": {}
      },
      "id": "fc7a38f0-5f75-499a-a3a4-2bc34cde9da9",
      "name": "Choose listing",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [
        1920,
        160
      ],
      "webhookId": "10277711-ef62-4d91-bd69-92cdd718b50d"
    },
    {
      "parameters": {
        "jsCode": "const prefix = $('Parse listings').first().json.prefix;\nconst typed = String($json['Existing listing'] || '').trim().toUpperCase();\nif (!typed) {\n  return [{ json: { prefix, listing: null } }];\n}\nconst listings = $('Parse listings').first().json.listings;\nconst match = typed.match(/^([A-Z]{3})([0-9]{3})$/);\nconst known = listings.map((l) => l.sku_root);\nif (!match || match[1] !== prefix || !known.includes(typed)) {\n  throw new Error(`\"${typed}\" is not an existing listing under ${prefix}. Valid: ${known.join(', ') || '(none yet)'}`);\n}\nreturn [{ json: { prefix, listing: Number(match[2]) } }];"
      },
      "id": "94ee16d2-8e40-4e02-bd83-2f63cbe25e1d",
      "name": "Decide listing",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2160,
        160
      ]
    },
    {
      "parameters": {
        "jsCode": "return [{ json: $input.first().json }];"
      },
      "id": "805be8e1-8f27-431f-87e1-f90b2e3e1291",
      "name": "Resolve product choice",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1920,
        0
      ]
    },
    {
      "parameters": {
        "command": "=sticker-tool mkincoming --exec-id {{ $execution.id }}"
      },
      "id": "9d51efac-ac73-5f6e-8db2-07d598b2b3ba",
      "name": "Make incoming folder",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [
        2160,
        0
      ],
      "executeOnce": true
    },
    {
      "parameters": {
        "jsCode": "const form = $('Sticker intake form').first();\nconst choice = $('Resolve product choice').first().json;\nconst allowed = { 'image/png': 'png', 'image/jpeg': 'jpg' };\nconst files = [];\nconst out = [];\n\n// One item per accepted upload. Only the extension is taken from the MIME\n// type (allow-list); the stored name is always a server-made 001.png style\n// name. Original names travel in request.json as data, never in a command.\nfor (const [, binary] of Object.entries(form.binary || {})) {\n  const extension = allowed[binary.mimeType];\n  if (!extension) continue;\n  const name = String(files.length + 1).padStart(3, '0') + '.' + extension;\n  files.push({ file: name, original_name: String(binary.fileName || '') });\n  out.push({ json: { targetName: name }, binary: { data: binary } });\n}\n\nconst quantity = form.json['Quantity (optional)'];\nconst request = {\n  size_in: Number(form.json['Sticker size (inches, longest side)']),\n  sheets: [].concat(form.json['Sheet types'] || []),\n  // An empty Quantity field submits as 0 in this n8n version, not '' or\n  // null/undefined -- and 0 is never a valid quantity anyway (sticker-tool\n  // requires >= 1 when given at all), so treat it the same as not provided.\n  quantity: quantity ? Number(quantity) : null,\n  files,\n  prefix: choice.prefix,\n  listing: choice.listing,\n};\n\nconst requestFile = await this.helpers.prepareBinaryData(\n  Buffer.from(JSON.stringify(request)), 'request.json', 'application/json');\nout.push({ json: { targetName: 'request.json' }, binary: { data: requestFile } });\nreturn out;"
      },
      "id": "0a71e323-a6fd-5b37-824a-1835bd49d0aa",
      "name": "Prepare files",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2400,
        0
      ]
    },
    {
      "parameters": {
        "operation": "write",
        "fileName": "=/data/state/incoming/{{ $execution.id }}/{{ $json.targetName }}",
        "dataPropertyName": "data",
        "options": {}
      },
      "id": "c486942e-75d8-51da-8914-35aa5eee6369",
      "name": "Save uploads",
      "type": "n8n-nodes-base.readWriteFile",
      "typeVersion": 1,
      "position": [
        2640,
        0
