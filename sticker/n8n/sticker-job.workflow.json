      ],
      "executeOnce": true
    },
    {
      "parameters": {
        "jsCode": "// First pass has no Decision, so the default profile is used. The re-run\n// choices from the approval form map to fixed profile names in sticker-tool.\nconst decision = $input.first().json.Decision;\nconst profiles = {\n  'Re-run with a wider gap': 'wide-gap',\n  'Re-run with more rotations': 'more-rotations',\n};\nreturn [{ json: {\n  job_id: $('Parse intake').first().json.job_id,\n  profile: profiles[decision] || 'default',\n} }];"
      },
      "id": "a4fa68e2-728a-57a9-a583-f00d6775d1f8",
      "name": "Choose profile",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3600,
        0
      ]
    },
    {
      "parameters": {
        "command": "=sticker-tool nest --job {{ $json.job_id }} --profile {{ $json.profile }}"
      },
      "id": "75565d6d-323c-51ec-a70b-027d7ab9f619",
      "name": "Nest sheets",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [
        3840,
        0
      ],
      "executeOnce": true
    },
    {
      "parameters": {
        "jsCode": "const result = JSON.parse($input.first().json.stdout);\nconst lines = result.sheets.map((s) =>\n  `${s.sku} ${s.sheet}: ${s.copies} copies, ${s.fill_percent}% filled` +\n  (s.sheets_needed ? `, ${s.sheets_needed} sheet(s) for the order` : ''));\nreturn [{ json: {\n  job_id: result.job_id,\n  profile: result.profile,\n  summary_text: lines.join('\\n'),\n  sheets: result.sheets,\n} }];"
      },
      "id": "fe64f61e-c57c-5d17-b18b-79db96d49f0e",
      "name": "Summarize layout",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        4080,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "return $('Summarize layout').first().json.sheets.map((s) => ({ json: s }));"
      },
      "id": "8039abdd-d3ed-4ce9-95fa-72f3ae8ed079",
      "name": "Split sheets",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        4320,
        0
      ]
    },
    {
      "parameters": {
        "operation": "read",
        "fileSelector": "=/data/outbox/.staging/{{ $('Parse intake').first().json.job_id }}/{{ $json.preview }}",
        "options": {}
      },
      "id": "61101c5a-42b2-4439-8fd6-c59e3d284ce6",
      "name": "Read preview image",
      "type": "n8n-nodes-base.readWriteFile",
      "typeVersion": 1,
      "position": [
        4560,
        0
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const parts = $input.all().map((item) => {\n  const binary = item.binary.data;\n  return `<div style=\"margin-bottom:8px\"><strong>${item.json.sku} ${item.json.sheet}</strong> -- ${item.json.copies} copies, ${item.json.fill_percent}% filled<br/>` +\n    `<img src=\"data:${binary.mimeType};base64,${binary.data}\" style=\"max-width:420px;border:1px solid #ccc\"/></div>`;\n});\nreturn [{ json: { preview_html: parts.join('') } }];"
      },
      "id": "4bc60e39-d544-41c5-9f78-c107b364bcfd",
      "name": "Combine previews HTML",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        4800,
        0
      ]
    },
    {
      "parameters": {
        "command": "=sticker-tool note-approval --job {{ $('Summarize layout').first().json.job_id }} --url \"{{ $execution.resumeFormUrl }}\""
      },
