        "formDescription": "=Job {{ $('Summarize layout').first().json.job_id }} (profile: {{ $('Summarize layout').first().json.profile }})\\n\\nOpen the preview images in Shop-Outbox/.staging/{{ $('Summarize layout').first().json.job_id }} to review the layout.\\n\\n{{ $('Summarize layout').first().json.summary_text }}",
